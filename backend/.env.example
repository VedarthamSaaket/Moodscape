# Required for the backend to boot. validate_secrets() refuses to start
# without any of these. Real values go in backend/.env (gitignored).

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/moodscape
HF_API_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://YOUR_DOMAIN/callback
SPOTIFY_SCOPES=playlist-modify-public playlist-modify-private ugc-image-upload
GMAIL_USER=your-mailer@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# HMAC signing key for session tokens. Rotate to invalidate every active
# session. Use `python -c "import secrets; print(secrets.token_hex(32))"`.
SESSION_SECRET=

# Image-provider keys. Frontend never sees these — /api/images/search
# forwards the query with these credentials.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional. Required only for in-app YouTube playback resolver.
YOUTUBE_API_KEY=

# Optional. Public origin of the frontend, used to build reset-link emails.
FRONTEND_URL=https://YOUR_DOMAIN

# Optional. Force every http:// request to redirect to https://. Enable in
# production behind a TLS terminator; leave unset in local dev.
FORCE_HTTPS=true
