# Frontend env vars are inlined into the production JS bundle at build
# time. NEVER put a secret here. Anyone who opens DevTools can read it.
#
# Only public configuration belongs in this file: the API base URL and
# the public Spotify client id (which is meant to be public).

# Backend origin. Leave empty for same-origin deployments.
VITE_API_BASE_URL=https://api.YOUR_DOMAIN

# Spotify client id is a public identifier — pair it with the server-side
# SPOTIFY_CLIENT_SECRET (in backend/.env). The secret stays on the server.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=https://YOUR_DOMAIN/callback
